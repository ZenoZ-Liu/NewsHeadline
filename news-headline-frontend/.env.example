# 复制本文件为 .env 后按需修改；.env 已被 .gitignore 忽略
# cp .env.example .env
# 修改 .env 后需要重启 npm run dev 才会生效

# 后端地址（默认 http://127.0.0.1:8000）
VITE_API_BASE_URL=http://127.0.0.1:8000

# ---------- AI 问答（可选） ----------
# 默认使用阿里云百炼 DashScope 的 OpenAI 兼容接口
VITE_AI_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
VITE_AI_MODEL=qwen3-max-preview

# 警告：VITE_ 开头的变量会被明文打包进 dist，等同于公开信息。
# 这里填写的 Key 仅适合本地调试；公开部署请改为由后端代理调用。
VITE_AI_API_KEY=
