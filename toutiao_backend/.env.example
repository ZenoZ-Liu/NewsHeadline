# 复制本文件为 .env 后按本机环境填写；.env 已被 .gitignore 忽略，不要提交
# cp .env.example .env

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=news_app
MYSQL_CHARSET=utf8mb4

# 也可以直接给一整条连接串，填写后覆盖上面的 MYSQL_* 配置
# DATABASE_URL=mysql+aiomysql://root:password@127.0.0.1:3306/news_app?charset=utf8mb4

# 连接池
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# 打印 SQL 语句，调试时设为 true
SQL_ECHO=false

# ---------- Redis ----------
# Redis 未启动时服务仍可运行，只是缓存失效、每次都查数据库
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# 无密码留空
REDIS_PASSWORD=
